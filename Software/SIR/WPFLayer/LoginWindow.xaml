<Window x:Class="WPFLayer.LoginWindow"
        Icon="pack://application:,,,/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login"
        Height="240"
        Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Username" />
        <TextBox x:Name="txtUsername" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"  VerticalAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Password" />
        <PasswordBox x:Name="txtPassword" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" VerticalAlignment="Center"/>

        <TextBlock x:Name="lblText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10" Foreground="Crimson" HorizontalAlignment="Center"/>

        <Button x:Name="btnLogin" Grid.Row="3" Grid.ColumnSpan="2" Height="32" Content="Login" IsDefault="True" Click="LoginButton_Click" />
    </Grid>
</Window>
