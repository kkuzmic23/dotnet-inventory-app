<UserControl x:Class="WPFLayer.StockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Background="#FFEFEFEF">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <Button Name="btnLoadStock" Height="25" Content="Show Stock" Click="btnLoadStock_Click" />
        </StackPanel>
        <DataGrid Name="dgStock" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product Code" Binding="{Binding Product.ProductCode}" />
                <DataGridTextColumn Header="Product Name" Binding="{Binding Product.Name}" />
                <DataGridTextColumn Header="Description" Binding="{Binding Product.Description}" />
                <DataGridTextColumn Header="Supplier" Binding="{Binding Product.Supplier.Name}" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" />
                <DataGridTextColumn Header="Reorder Level" Binding="{Binding Product.ReorderLevel}" />
                <DataGridTextColumn Header="Active" Binding="{Binding Product.IsActive}" />
                <DataGridTextColumn Header="Created" Binding="{Binding Product.CreatedAt, StringFormat=\{0:yyyy-MM-dd\}}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
