<UserControl x:Class="WPFLayer.OrdersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFLayer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <DockPanel Grid.Row="1">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="#FFEFEFEF">
            <Button Width="50" Height=" 25">Load</Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Background="#FFEFEFEF">
            <Button Width="50" Height=" 25">Add</Button>
            <Button Width="50" Height=" 25">Update</Button>
            <Button Width="50" Height=" 25">Delete</Button>
        </StackPanel>
        <DataGrid />
    </DockPanel>
</UserControl>
