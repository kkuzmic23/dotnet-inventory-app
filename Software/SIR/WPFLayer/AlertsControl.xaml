<UserControl x:Class="WPFLayer.AlertsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Alerts" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Low stock notifications" Opacity="0.7"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Opacity="0.6"
                       Text="{Binding ElementName=lstAlerts, Path=Items.Count, StringFormat=Count: {0}}"/>
        </DockPanel>

        <!-- Cards list -->
        <ListView x:Name="lstAlerts"
                  Grid.Row="1"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8"
                            Padding="12"
                            BorderThickness="1"
                            BorderBrush="#FFE0E0E0"
                            Background="White">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <!-- Severity dot -->
                            <Ellipse Width="14" Height="14" VerticalAlignment="Top" Margin="8,4,0,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FFF2B705"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCriticalStock}" Value="True">
                                                <Setter Property="Fill" Value="#FFE53935"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Main text -->
                            <StackPanel Grid.Column="1" Margin="6,0,12,0">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>

                                <TextBlock Opacity="0.75" Margin="0,2,0,0"
                                    Text="{Binding AlertMessage, Mode=OneWay}" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border CornerRadius="8" Padding="8,3" Background="#FFF3F3F3" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding CurrentQuantity, Mode=OneWay, StringFormat=QTY: {0}}" />
                                    </Border>

                                    <Border CornerRadius="8" Padding="8,3" Background="#FFF3F3F3" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ReorderLevel, Mode=OneWay, StringFormat=MIN: {0}}" />
                                    </Border>

                                    <Border CornerRadius="8" Padding="8,3" Background="#FFF3F3F3">
                                        <TextBlock Text="{Binding MissingToMinimum, Mode=OneWay, StringFormat=MISSING: {0}}" />
                                    </Border>
                                </StackPanel>

                            </StackPanel>

                            <!-- Right side badge -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFF3CD"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCriticalStock}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFE5E5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Warning"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCriticalStock}" Value="True">
                                                        <Setter Property="Text" Value="Critical"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <TextBlock Text="{Binding LastRestockAgo, Mode=OneWay}"
                                   Opacity="0.6"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,0,0"/>

                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
