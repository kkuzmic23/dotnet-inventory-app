<UserControl x:Class="WPFLayer.Statistics"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Background="{StaticResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Statistics"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Overview &amp; reports"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnReport"
                            Style="{StaticResource GhostButton}"
                            Content="Report"
                            Height="34"
                            MinWidth="90"
                            Margin="0,0,10,0"
                            Click="BtnReport_Click"/>

                        <Button x:Name="btnRefresh"
                            Style="{StaticResource PrimaryButton}"
                            Content="Refresh"
                            Height="34"
                            MinWidth="90"
                            Click="BtnRefresh_Click"/>
                    </StackPanel>

                </Grid>

                <!-- FILTERS -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,12"
                        Padding="12">
                    <WrapPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" Margin="0,0,14,10">
                            <TextBlock Text="From:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedText}"
                                       Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpFrom"
                                        Style="{StaticResource ModernDatePicker}"
                                        Width="160"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,14,10">
                            <TextBlock Text="To:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedText}"
                                       Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpTo"
                                        Style="{StaticResource ModernDatePicker}"
                                        Width="160"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,14,10">
                            <TextBlock Text="Preset:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedText}"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbPeriod"
                                      Style="{StaticResource ModernComboBox}"
                                      Width="180"
                                      SelectionChanged="CmbPeriod_SelectionChanged"/>
                        </StackPanel>

                        <Button x:Name="btnApply"
                                Style="{StaticResource GhostButton}"
                                Content="Apply"
                                Height="34"
                                MinWidth="84"
                                Margin="0,0,10,10"
                                Click="BtnApply_Click"/>

                        <Button x:Name="btnReset"
                                Style="{StaticResource GhostButton}"
                                Content="Reset"
                                Height="34"
                                MinWidth="84"
                                Margin="0,0,0,10"
                                Click="BtnReset_Click"/>

                    </WrapPanel>
                </Border>

                <!-- KPI CARDS (wrap) -->
                <WrapPanel Grid.Row="2" Margin="0,0,0,12" ItemWidth="230">

                    <!-- Low Stock -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="14"
                            Margin="0,0,12,12"
                            Width="230">
                        <StackPanel>
                            <TextBlock Text="Low Stock Items"
                                       Foreground="{StaticResource MutedText}"/>
                            <TextBlock x:Name="txtLowStock"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Incoming -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="14"
                            Margin="0,0,12,12"
                            Width="230">
                        <StackPanel>
                            <TextBlock Text="Incoming Units"
                                       Foreground="{StaticResource MutedText}"/>
                            <TextBlock x:Name="txtIncoming"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Orders -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="14"
                            Margin="0,0,12,12"
                            Width="230">
                        <StackPanel>
                            <TextBlock Text="Total Orders"
                                       Foreground="{StaticResource MutedText}"/>
                            <TextBlock x:Name="txtOrders"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Lead -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="14"
                            Margin="0,0,0,12"
                            Width="230">
                        <StackPanel>
                            <TextBlock Text="Avg Lead Time"
                                       Foreground="{StaticResource MutedText}"/>
                            <TextBlock x:Name="txtLead"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- CHART + BREAKDOWN (wrap to new row when narrow) -->
                <WrapPanel Grid.Row="3">

                    <!-- Chart card -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="12"
                            Margin="0,0,12,12"
                            MinWidth="520"
                            MaxWidth="650">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <TextBlock Text="Incoming vs Outgoing"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           DockPanel.Dock="Left"/>

                                <ComboBox x:Name="cmbChartMode"
                                          Style="{StaticResource ModernComboBox}"
                                          Width="150"
                                          DockPanel.Dock="Right"
                                          SelectionChanged="CmbChartMode_SelectionChanged"/>
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Background="#FFF6F7F9"
                                    CornerRadius="10"
                                    Padding="10">
                                <Grid>
                                    <Canvas x:Name="cnvChart"
                                            Height="260"
                                            Background="Transparent"/>
                                    <!-- Tooltip popup (if you use it) -->
                                    <Popup x:Name="pChartTip" Placement="Mouse" AllowsTransparency="True" StaysOpen="True">
                                        <Border Background="#FF111827"
                                                CornerRadius="8"
                                                Padding="10"
                                                Opacity="0.95"
                                                IsHitTestVisible="False">
                                            <TextBlock x:Name="txtChartTip"
                                                       Foreground="White"
                                                       FontSize="12"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Breakdown card -->
                    <!-- Breakdown card -->
                    <Border Style="{StaticResource CardBorderStyle}"
        Padding="12"
        Margin="0,0,0,12"
        MinWidth="320"
        MaxWidth="360">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtBreakdownTitle"
                       Text="Top Suppliers"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

                                <ComboBox x:Name="cmbBreakdownMode"
                      Grid.Column="1"
                      Style="{StaticResource ModernComboBox}"
                      Width="160"
                      VerticalAlignment="Center"
                      SelectionChanged="CmbBreakdownMode_SelectionChanged"/>
                            </Grid>

                            <!-- Content row -->
                            <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="icBreakdown">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource Primary}"
                                       Margin="0,0,10,0"
                                       TextTrimming="CharacterEllipsis"/>

                                                <ProgressBar Grid.Column="1"
                                         Height="10"
                                         Value="{Binding Percent}"
                                         Maximum="100"
                                         Margin="0,4,10,0"/>

                                                <TextBlock Grid.Column="2"
                                       Text="{Binding ValueText}"
                                       Foreground="{StaticResource MutedText}"
                                       HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>


                </WrapPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
