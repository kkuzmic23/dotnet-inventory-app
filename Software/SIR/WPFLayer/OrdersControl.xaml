<UserControl x:Class="WPFLayer.OrdersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFLayer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <DockPanel Grid.Row="1" Background="#FFEFEFEF">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <Button x:Name="btnLoad" Width="50" Height=" 25" Click="Button_Click">Load</Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right">
            <Button x:Name="btnAdd" Width="50" Height=" 25" Click="btnAdd_Click">Add</Button>
            <Button x:Name="btnUpdate" Width="50" Height=" 25" Click="btnUpdate_Click">Update</Button>
            <Button x:Name="btnDelete" Width="50" Height=" 25" Click="btnDelete_Click">Delete</Button>
        </StackPanel>
        <DataGrid x:Name="dgOrders" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt}" />
                <DataGridTextColumn Header="Recieved At" Binding="{Binding ReceivedAt}" />
                <DataGridTextColumn Header="Supplier Name" Binding="{Binding Supplier.Name}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
