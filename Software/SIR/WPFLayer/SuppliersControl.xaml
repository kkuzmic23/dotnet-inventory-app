<UserControl x:Class="WPFLayer.SuppliersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFLayer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Grid.Row="1">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="#FFEFEFEF">
            <Button x:Name="btnLoad" Width="50" Height="25" Click="btnLoad_Click">Load</Button>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Background="#FFEFEFEF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAllProductsFromSupplier" Grid.Column="0" Width="180" Height="25" Click="btnAllProductsFromSupplier_Click">All products from this supplier</Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnAdd" Width="50" Height="25" Click="btnAdd_Click">Add</Button>
                <Button x:Name="btnUpdate" Width="50" Height="25" Click="btnUpdate_Click">Update</Button>
                <Button x:Name="btnDelete" Width="70" Height="25" Click="btnDelete_Click">Discontinue</Button>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="dgSupplier" />
    </DockPanel>
</UserControl>
