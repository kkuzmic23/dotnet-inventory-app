<UserControl x:Class="WPFLayer.ProductsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFLayer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Grid.Row="1">
        <Grid DockPanel.Dock="Top" Background="#FFEFEFEF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                <Button x:Name="btnLoad" Width="50" Height="25" Margin="0,0,8,0" Click="btnLoad_Click">Load</Button>

                <TextBlock VerticalAlignment="Center" Margin="0,0,4,0">Search</TextBlock>

                <TextBox Width="140" Height="23" x:Name="txtSearchProducts"/>
            </StackPanel>


            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,6,0"> Filter by supplier</TextBlock>
                <ComboBox x:Name="cmbFilter" Width="140" SelectionChanged="cmbFilter_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Background="#FFEFEFEF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnFindSupplier" Grid.Column="0" Width="90" Height="25" HorizontalAlignment="Left" Click="btnFindSupplier_Click">Find supplier</Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnAdd" Width="50" Height="25" Click="btnAdd_Click">Add</Button>
                <Button x:Name="btnUpdate" Width="50" Height="25" Click="btnUpdate_Click">Update</Button>
                <Button x:Name="btnDelete" Width="70" Height="25" Click="btnDelete_Click">Discontinue</Button>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="dgProducts" />
    </DockPanel>
</UserControl>
