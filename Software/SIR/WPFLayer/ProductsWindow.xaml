<Window x:Class="WPFLayer.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFLayer"
        mc:Ignorable="d"
        Title="ProductsWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label x:Name="lblProducts" Grid.Row="0" Height="50" Background="#FFFF3D3D" Foreground="White" FontSize="25" FontWeight="DemiBold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">Products</Label>
        <DockPanel Grid.Row="1">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnLoad" Grid.Column="0" Width="50" Height="25">Load</Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="lblSupplierFilter" VerticalAlignment="Center" Margin="0,0,6,0"> Filter by supplier </TextBlock>
                    <ComboBox x:Name="cmbSupplier" Width="140"/>
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnFindSupplier" Grid.Column="0" Width="90" Height="25">Find supplier</Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnAdd" Width="50" Height="25">Add</Button>
                    <Button x:Name="btnUpdate" Width="50" Height="25">Update</Button>
                    <Button x:Name="btnDelete" Width="50" Height="25">Delete</Button>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="dgProducts" />
        </DockPanel>

    </Grid>
</Window>
